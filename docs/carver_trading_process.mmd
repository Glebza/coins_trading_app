flowchart TD
    A[Instrument universe] --> B[Instrument selection]
    B --> C[Rule hypothesis]
    C --> D[Trading rule / variation]
    D --> E[Quantified forecast]
    E --> F[Stop-loss check]
    F --> G[Volatility target]
    G --> H[Position sizing]
    H --> I[Portfolio adjustment]
    I --> J[Trade execution]
    J --> K[Daily housekeeping]
    K --> L[Performance and calibration]
    L --> C

    B --> B1[Liquidity, volatility, costs, tradability]
    C --> C1[Cause, effect, horizon, falsifiability]
    D --> D1[Pure rule: prices -> forecast]
    E --> E1[-20 very strong sell ... 0 neutral ... +20 very strong buy]
    F --> F1[Only systematic trailing stop-loss; no profit target]
    G --> G1[Annual target -> daily cash volatility target]
    H --> H1[forecast x volatility scalar / 10]
    I --> I1[Instrument weight x diversification multiplier]
    J --> J1[Round to blocks, apply position inertia]
    K --> K1[Refresh prices, vol estimates, stops, positions]
