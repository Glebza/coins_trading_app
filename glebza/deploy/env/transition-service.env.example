# Copy to /etc/glebza/transition-service.env on the server (remote-install-transition.sh writes this).
GLEBZA_ROOT=/opt/glebza
TRADEAPP_DIR=/opt/glebza/tradeapp
TRANSITION_SERVICE_DIR=/opt/glebza/transition_service

# Source: backtest research database
DATABASE_URL=postgresql://trader:CHANGE_ME@localhost:5432/backtest
DATABASE_DEFAULT_SCHEMA=backtests

# Target: live/paper trader database
LIVE_DATABASE_URL=postgresql://trader:CHANGE_ME@localhost:5432/traderdb
LIVE_DATABASE_DEFAULT_SCHEMA=public
