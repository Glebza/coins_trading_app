# Copy to deploy.env (gitignored) and fill BEFORE running deploy scripts.
#
# cp glebza/deploy/env/deploy.env.example glebza/deploy/env/deploy.env

# --- Required (laptop: deploy.env / shell; passed to remote-install.sh over SSH) ---

# SSH target when deploying from your laptop
DEPLOY_REMOTE=trader@your-server

# PostgreSQL superuser — Liquibase bootstrap only (CREATE ROLE/DATABASE)
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=CHANGE_ME

# Application DB role (created by bootstrap if missing)
TRADER_PASSWORD=CHANGE_ME

# T-Invest API token (checked on server before DB migrations)
INVEST_TOKEN=CHANGE_ME

# --- Optional paths on the remote server (defaults shown) ---

GLEBZA_ROOT=/opt/glebza
TRADEAPP_DIR=/opt/glebza/tradeapp
DAILY_LOADER_DIR=/opt/glebza/daily_loader
# DB_DIR defaults to ${TRADEAPP_DIR}/db

# --- Optional PostgreSQL connection ---

PG_HOST=localhost
PG_PORT=5432

# --- Optional tooling ---

GLEBZA_LIQUIBASE_VERSION=4.31.1
ENV_FILE=/etc/glebza/daily-loader.env
