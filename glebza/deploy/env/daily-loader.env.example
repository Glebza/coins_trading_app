# Installed on the server as /etc/glebza/daily-loader.env

GLEBZA_ROOT=/opt/glebza
TRADEAPP_DIR=/opt/glebza/tradeapp
DAILY_LOADER_DIR=/opt/glebza/daily_loader

DATABASE_URL=postgresql://trader:CHANGE_ME@localhost:5432/backtest
DATABASE_DEFAULT_SCHEMA=backtests
INVEST_TOKEN=CHANGE_ME

DAILY_LOADER_KLINE_INTERVAL=1d
DAILY_LOADER_KLINE_LOOKBACK_DAYS=1
DAILY_LOADER_DIVIDEND_LOOKBACK_DAYS=365
DAILY_LOADER_RUONIA_LOOKBACK_DAYS=30
DAILY_LOADER_VOL_LOOKBACK_PERIOD=252
DAILY_LOADER_KLINE_REQUEST_DELAY_SECONDS=0.3
DAILY_LOADER_DIVIDEND_REQUEST_DELAY_SECONDS=0.5
DAILY_LOADER_RATE_LIMIT_RETRIES=3
DAILY_LOADER_RATE_LIMIT_FALLBACK_SLEEP_SECONDS=60

# Optional — for manual backfill via daily-loader-backfill.service (TODO: automate in deploy)
# BACKFILL_START_DT=2020-01-01T00:00:00+00:00
# BACKFILL_END_DT=2026-06-01T00:00:00+00:00
